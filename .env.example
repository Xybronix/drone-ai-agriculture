# =============================================================================
# Drone AI Agriculture - Configuration
# Copy this file to .env and customize values
# =============================================================================
 
# === API Configuration ===
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v1
DEBUG=false
ENVIRONMENT=production

# === Ngrok Configuration ===
USE_NGROK=true
NGROK_AUTH_TOKEN=38brD40lpb3p38HHKcagkgigAV7_4Y6SPUba9mNdshfbZ8Tbe

# === Security ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# === Database ===
# SQLite (default - no setup required)
DATABASE_URL=sqlite+aiosqlite:///./data/agriculture.db

# PostgreSQL (production recommended)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/drone_agriculture

# === AI Model ===
MODEL_PATH=./models/agriculture_model.h5
ONNX_MODEL_PATH=./models/agriculture_model.onnx
CONFIDENCE_THRESHOLD=0.85
MAX_IMAGE_SIZE=1920
BATCH_SIZE=32

# === Plant.id Configuration ===
PLANT_ID_API_KEY=CWnhylI5c9aeJ9yq3Sko1spOhPAAhIn02QXXfSbqYbNPqD1mN5
EXTERNAL_AI_FALLBACK=true
DEBUG=true

# === AI Backend Configuration ===
AI_BACKEND=auto

# === Storage Configuration ===
# Options: local, s3, minio
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./data/uploads

# S3/MinIO Configuration (if STORAGE_TYPE=s3 or minio)
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_BUCKET_NAME=drone-agriculture-images
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=eu-west-1

# MinIO Configuration (alternative to S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=drone-agriculture
MINIO_SECURE=false

# === Rate Limiting ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/api.log

# === Drone Configuration ===
DRONE_API_KEY=drone-specific-api-key
DRONE_HEARTBEAT_INTERVAL=30
OFFLINE_QUEUE_MAX_SIZE=1000

# === Monitoring ===
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
HEALTH_CHECK_INTERVAL=60

# === Dataset Configuration ===
# Kaggle credentials (for automatic dataset download)
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# Dataset paths
DATASET_PATH=./data/datasets
DATASET_CACHE_PATH=./data/cache

# === WebSocket Configuration ===
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# === Email Notifications (optional) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=alerts@yourdomain.com

# === External APIs (optional) ===
WEATHER_API_KEY=your-openweathermap-api-key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5